# ==============================================================================
# lullabAI_twins — Edge Node Camera Configuration (TP-Link Tapo C260 / TP260)
# Copy this file to `edge/.env` and replace with your camera's credentials & IP:
#   cp edge/.env.example edge/.env
# ==============================================================================

# 1. Create a Camera Account in the Tapo App:
#    Tapo App -> Select TP260 -> Device Settings (Gear icon) -> Advanced Settings -> Camera Account
# 2. Find your camera's IP address:
#    Tapo App -> Select TP260 -> Device Settings -> Device Info -> IP Address (e.g., 192.168.1.120)
#
# Note: If your password has special characters (like @, :, #, /), URL-encode them
# or use an alphanumeric password in the Tapo Camera Account settings.

# Main high-res stream (4K / 2K) used for live WebRTC viewing in the PWA
BABY_1_MAIN_RTSP=rtsp://tapo_user:tapo_password@192.168.1.120:554/stream1

# Sub stream (360p) used by System 1 Python AI Detector (low CPU + includes audio)
BABY_1_SUB_RTSP=rtsp://tapo_user:tapo_password@192.168.1.120:554/stream2

# Subject mode: "BABY" (markerless infant detection, no band needed) or "PET_TEST"
SUBJECT_MODE=BABY

# Set to 127.0.0.1 when a local HTTPS reverse proxy serves the dashboard.
# LULLABAI_BIND_ADDRESS=127.0.0.1

# The Edge setup code also authorizes cloud review and video retention changes.
# For background Web Push, also generate push-secrets/vapid.pem and set WEB_PUSH_SUBJECT.
# WEB_PUSH_SUBJECT=mailto:you@example.com
# WEB_PUSH_SETUP_CODE=
